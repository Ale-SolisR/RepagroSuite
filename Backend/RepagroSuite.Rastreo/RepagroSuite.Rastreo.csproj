<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Módulo de Rastreo incorporado al backend único de Repagro Suite (Opción B).
    Es una BIBLIOTECA (no Web): no tiene Program.cs propio. El host RepagroSuite.API
    lo arranca vía RastreoModule (DI + 2.º esquema JWT "Rastreo" + migraciones/seed) y
    descubre sus controladores con AddApplicationPart. Conserva el namespace Rastreo.Api.*
    y su propio esquema RASTREO en BD, totalmente aislado de la identidad de Repagro.
  -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Rastreo.Api</RootNamespace>
    <AssemblyName>RepagroSuite.Rastreo</AssemblyName>
  </PropertyGroup>

  <!-- Necesita el framework de ASP.NET Core para controladores, [Authorize], etc. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Implicit usings que el SDK Web añade por defecto (este proyecto es biblioteca, no Web). -->
  <ItemGroup>
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Hosting" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <!-- Assets de marca (logo PNG) usados por los PDFs. -->
  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="MailKit" Version="4.16.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.5" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.5" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="QuestPDF" Version="2026.5.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
    <PackageReference Include="SkiaSharp" Version="3.116.1" />
  </ItemGroup>

</Project>
