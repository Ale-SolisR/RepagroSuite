{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Key": "",
    "Issuer": "RepagroSuite.API",
    "Audience": "RepagroSuite.Client",
    "ExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 30
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost:3000" ],
    "AllowedOriginPatterns": [ "^https://([a-z0-9-]+--)?[a-z0-9-]+\\.netlify\\.app$" ]
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/repagro-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] [{CorrelationId}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Email": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "UseSsl": false,
    "Username": "gestionwebrepagro@gmail.com",
    "Password": "",
    "FromName": "RepagroSuite",
    "FromAddress": "gestionwebrepagro@gmail.com"
  },
  "Rastreo": {
    "Jwt": {
      "Key": "",
      "Issuer": "Rastreo.Api",
      "Audience": "Rastreo.Client",
      "_comment_ExpiryMinutes": "Vida del JWT (credencial). La expiración REAL es la ventana deslizante de 3h en BD (SesionExpira); por eso el token dura 7 días.",
      "ExpiryMinutes": 10080
    },
    "Email": {
      "SmtpHost": "smtp.gmail.com",
      "SmtpPort": 587,
      "UseSsl": false,
      "Username": "gestionwebrepagro@gmail.com",
      "Password": "",
      "FromName": "RASTREO",
      "FromAddress": "gestionwebrepagro@gmail.com"
    }
  },
  "IDENTIFICATION_CACHE_ENABLED": "true",
  "IDENTIFICATION_CACHE_DAYS": "30",
  "IDENTIFICATION_BASE_URL": "https://apis.gometa.org/cedulas/",
  "IDENTIFICATION_TIMEOUT_SECONDS": "10",
  "RateLimit": {
    "AuthRequestsPerMinute": 5,
    "RefreshRequestsPerMinute": 20
  },
  "AllowedHosts": "*"
}
